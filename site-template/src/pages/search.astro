---
import SearchApp from "../components/SearchApp";
import WikiLayout from "../layouts/WikiLayout.astro";
import { site } from "../lib/site";
---

<WikiLayout title="検索">
  <div class="page-title"><span class="eyebrow">Search the wiki</span><h1>検索</h1><p>タイトル・本文・構造化データから記事を見つけます。</p></div>
  <script is:inline src={site.base + "runtime/graph-md-query-runtime.js"}></script>
  <SearchApp client:load documents={site.documents} base={site.base} />
</WikiLayout>
