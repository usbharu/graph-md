---
import GraphApp from "../components/GraphApp";
import WikiLayout from "../layouts/WikiLayout.astro";
import { site } from "../lib/site";
---

<WikiLayout title="グラフ">
  <div class="page-title"><span class="eyebrow">Explore relationships</span><h1>知識グラフ</h1><p>記事間のつながりを視覚的にたどれます。</p></div>
  <GraphApp
    client:only="react"
    elements={[...site.graph.nodes, ...site.graph.edges]}
  />
</WikiLayout>
