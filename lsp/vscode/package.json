{
  "name": "graph-md-vscode",
  "displayName": "GraphMD VSCode",
  "version": "0.1.0",
  "publisher": "usbharu",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onView:graphmd.search",
    "onCommand:graphmd.openSearch"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "graphmd.openSearch",
        "title": "GraphMD: 検索を開く",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "graphmd",
          "title": "GraphMD",
          "icon": "media/graphmd-search.svg"
        }
      ]
    },
    "views": {
      "graphmd": [
        {
          "id": "graphmd.search",
          "name": "検索",
          "type": "webview"
        }
      ]
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./preview/graphmd.css"
    ],
    "grammars": [
      {
        "scopeName": "graphmd.injection.markdown",
        "path": "./syntaxes/graphmd.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "graphmdRelationOperator",
        "description": "GraphMD relation operator"
      },
      {
        "id": "graphmdRelationLabel",
        "description": "GraphMD relation label"
      },
      {
        "id": "graphmdRelationTarget",
        "description": "GraphMD relation target"
      },
      {
        "id": "graphmdRelationType",
        "description": "GraphMD relation type"
      },
      {
        "id": "graphmdProperty",
        "description": "GraphMD property"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "markdown",
        "scopes": {
          "graphmdRelationOperator": [
            "keyword.control.graphmd",
            "punctuation.definition.link.graphmd"
          ],
          "graphmdRelationLabel": [
            "string.other.link.title.markdown"
          ],
          "graphmdRelationTarget": [
            "constant.other.reference.link.markdown",
            "entity.name.reference"
          ],
          "graphmdRelationType": [
            "entity.name.type.class"
          ],
          "graphmdProperty": [
            "variable.other.property.graphmd",
            "variable.other.member.graphmd"
          ]
        }
      }
    ]
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "sync-server": "bash sync-server.sh",
    "vscode:prepublish": "pnpm run sync-server && node esbuild.mjs --production",
    "package": "pnpm dlx @vscode/vsce@3.9.2 package",
    "build": "pnpm run sync-server && node esbuild.mjs",
    "compile": "tsc -p ./tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.12",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.1",
    "markdown-it-graphmd": "file:../../markdown-it-graphmd",
    "typescript": "^5.8.3",
    "vscode-languageclient": "^9.0.1"
  }
}
